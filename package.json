{
  "name": "shoesafari",
  "version": "1.0.0",
  "description": "Live online footwear store selling real products with Stellar USDC payments; over $10,000 USDC in product sales processed",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShoeSafari-Org/ShoeSafari.git"
  },
  "keywords": [
    "ecommerce",
    "stellar",
    "soroban",
    "blockchain",
    "crypto-payments",
    "nextjs",
    "web3"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit --skipLibCheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "deploy:testnet": "./scripts/deploy-testnet.sh",
    "prepare": "echo 'ShoeSafari ready!'"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.2.0",
    "@vercel/og": "^0.6.2",
    "firebase": "^10.12.4",
    "fs": "^0.0.1-security",
    "mongodb": "^6.8.0",
    "mongoose": "^8.5.1",
    "next": "14.2.5",
    "next-auth": "^4.24.7",
    "nextjs-toploader": "^1.6.12",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.2.1",
    "react-transition-group": "^4.4.5",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/next": "^9.0.0",
    "@types/node": "^20.19.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/ui": "^1.2.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "jsdom": "^24.0.0",
    "postcss": "^8",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
